{
  "schema_version": "1.0",
  "id": "hello_notch",
  "name": "Hello Notch",
  "version": "1.0.0",
  "description": "Simple daemon plugin that returns a deterministic ping response.",
  "components": {
    "client": {
      "runtime": "python",
      "entry": "client/plugin.py"
    }
  },
  "config_schema": {
    "client": {
      "type": "object",
      "properties": {
        "greeting": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "server": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    }
  }
}
