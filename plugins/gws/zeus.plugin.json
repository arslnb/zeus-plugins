{
  "schema_version": 1,
  "id": "gws",
  "name": "Google Workspace",
  "version": "0.1.0",
  "description": "Run Google Workspace operations through the gws CLI, including Gmail inbox triage.",
  "components": {
    "client": {
      "runtime": "python",
      "entry": "client/plugin.py"
    },
    "server": {
      "runtime": "python",
      "entry": "server/plugin.py",
      "channels": []
    }
  },
  "config_schema": {
    "client": {
      "gws_binary": {
        "type": "string",
        "secret": false,
        "required": false,
        "description": "Path or executable name for the Google Workspace CLI.",
        "default": "gws"
      },
      "default_user_id": {
        "type": "string",
        "secret": false,
        "required": false,
        "description": "Default Gmail user id for mailbox operations.",
        "default": "me"
      },
      "default_query": {
        "type": "string",
        "secret": false,
        "required": false,
        "description": "Default Gmail query for unread message triage.",
        "default": "in:inbox is:unread"
      },
      "default_max_results": {
        "type": "integer",
        "secret": false,
        "required": false,
        "description": "Default Gmail unread list size (1..25).",
        "default": 5
      },
      "timeout_seconds": {
        "type": "integer",
        "secret": false,
        "required": false,
        "description": "Timeout for gws subprocess calls.",
        "default": 45
      }
    },
    "server": {}
  },
  "secret_storage": "vault",
  "prerequisites": {
    "cli": [
      {
        "name": "Google Workspace CLI",
        "binary": "gws",
        "required": true,
        "install_hint": "npm install -g @googleworkspace/cli",
        "install_url": "https://github.com/googleworkspace/cli",
        "auto_install_commands": {
          "darwin": "npm install -g @googleworkspace/cli",
          "linux": "npm install -g @googleworkspace/cli"
        }
      },
      {
        "name": "Google Cloud SDK",
        "binary": "gcloud",
        "required": true,
        "install_hint": "brew install --cask google-cloud-sdk",
        "install_url": "https://cloud.google.com/sdk/docs/install",
        "auto_install_commands": {
          "darwin": "brew install --cask google-cloud-sdk",
          "linux": "curl -sSL https://sdk.cloud.google.com | bash"
        }
      }
    ]
  },
  "oauth": {
    "mode": "cli_sequence",
    "description": "Runs the gws agent-assisted auth flow in the daemon.",
    "setup_command": "gws auth setup",
    "login_command": "gws auth login",
    "agent_prompt": "Use gws auth setup once and gws auth login for refresh; follow any browser prompts."
  },
  "skills": {
    "bundled": true,
    "path": "skills",
    "auto_install": true,
    "auto_enable": true,
    "uninstall_policy": "remove"
  }
}
