{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arslnb.com/schemas/registry.metadata.schema.json",
  "title": "Zeus Registry Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "summary",
    "owner",
    "runtime",
    "categories",
    "min_zeus_version",
    "source_repo",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "runtime": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["client", "server"]
      },
      "uniqueItems": true
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40
      }
    },
    "min_zeus_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_repo": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    }
  }
}
